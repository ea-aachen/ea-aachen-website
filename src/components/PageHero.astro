---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line/60">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_80%_-20%,rgba(37,198,178,0.14),transparent_70%)]"></div>
  <div class="relative mx-auto max-w-4xl px-5 py-16 sm:py-20">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</p>}
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted">{lead}</p>}
  </div>
</section>
