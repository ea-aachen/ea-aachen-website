---
import { site } from '../data/site';
import { href } from '../lib/links';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (h: string) => path === href(h).replace(/\/$/, '');
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-ink/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
    <a href={href('/')} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <Logo class="h-7 w-7 text-accent" />
      <span class="text-fg">{site.shortName}</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {site.nav.map((item) => (
        <a
          href={href(item.href)}
          class:list={['text-sm transition-colors hover:text-fg', isActive(item.href) ? 'text-fg' : 'text-fg-muted']}
        >{item.label}</a>
      ))}
      <a
        href={href(site.cta.href)}
        class="rounded-full bg-accent px-4 py-2 text-sm font-semibold text-ink transition hover:bg-accent-soft"
      >{site.cta.label}</a>
    </div>

    <button id="navToggle" class="md:hidden text-fg" aria-label="Open menu" aria-expanded="false">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <div id="navMenu" class="hidden border-t border-line/60 bg-ink/95 px-5 py-4 md:hidden">
    <div class="flex flex-col gap-1">
      {site.nav.map((item) => (
        <a href={href(item.href)} class="rounded-lg px-3 py-2.5 text-fg-muted hover:bg-surface hover:text-fg">{item.label}</a>
      ))}
      <a href={href(site.cta.href)} class="mt-2 rounded-full bg-accent px-4 py-2.5 text-center font-semibold text-ink">{site.cta.label}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('navMenu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
