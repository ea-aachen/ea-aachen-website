---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import RegularMeetups from '../../components/RegularMeetups.astro';
import { href } from '../../lib/links';
import { whenLabel } from '../../lib/news';
import { site } from '../../data/site';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const upcoming = posts.filter((p) => p.data.upcoming);
const past = posts.filter((p) => !p.data.upcoming);
---

<Base title="News" description="What's coming up at EA Aachen, and what we've done so far.">
  <PageHero eyebrow="News" title="What's happening" lead="What's coming up, and what we've done so far." />

  <section class="mx-auto max-w-4xl px-5 py-16">
    {upcoming.length > 0 && (
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Coming up</h2>
        <div class="mt-5 space-y-4">
          {upcoming.map((p) => (
            <a href={href(`/news/${p.id}`)} class="block rounded-2xl border border-accent/60 bg-gradient-to-b from-ink-soft to-ink p-7 shadow-[var(--shadow-glow)] transition hover:border-accent">
              <p class="text-sm font-semibold text-accent">{whenLabel(p)}</p>
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-fg">{p.data.title}</h3>
              <p class="mt-3 leading-relaxed text-fg-muted">{p.data.summary}</p>
              <span class="mt-4 inline-block font-semibold text-accent">Read more →</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-10 rounded-2xl border border-line/60 bg-ink-soft p-7">
      <h2 class="text-lg font-semibold text-fg">Looking for regular meetups?</h2>
      <p class="mt-2 text-sm leading-relaxed text-fg-muted">
        <RegularMeetups /> To hear about our own events, get the newsletter or join the WhatsApp group.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={site.links.newsletter} class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-accent-soft">Get the newsletter</a>
        <a href={site.links.whatsapp} class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-fg transition hover:border-accent hover:text-accent">Join the WhatsApp group</a>
      </div>
    </div>

    {past.length > 0 && (
      <div class="mt-16">
        <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-fg-muted">What we've done</h2>
        <ul class="mt-5 divide-y divide-line/60 border-y border-line/60">
          {past.map((p) => (
            <li>
              <a href={href(`/news/${p.id}`)} class="group block py-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">{whenLabel(p)}</p>
                <h3 class="mt-1.5 text-xl font-semibold tracking-tight text-fg transition group-hover:text-accent">{p.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-fg-muted" lang={p.data.lang}>{p.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="mt-10 text-sm text-fg-muted">
      Older updates are in our <a href={site.links.newsletterArchive} class="text-accent hover:underline">newsletter archive</a>.
    </p>
  </section>
</Base>
