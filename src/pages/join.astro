---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RegularMeetups from '../components/RegularMeetups.astro';
import { site } from '../data/site';
import { href } from '../lib/links';
---

<Base title="Get Involved" description="Join Effective Altruism Aachen — sign up for the newsletter or join the WhatsApp group.">
  <PageHero
    eyebrow="Get involved"
    title="How to join us"
    lead="Our events are open to everyone. We're always happy to meet new people, whatever your background."
  />

  <section class="mx-auto max-w-4xl px-5 py-16">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href={site.links.newsletter} class="group rounded-2xl border border-line/60 bg-ink-soft p-6 transition hover:border-accent">
        <h3 class="text-lg font-semibold text-fg">Sign up for the newsletter</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">An email whenever something is coming up — events, trips to conferences and more.</p>
        <span class="mt-4 inline-block font-semibold text-accent">Subscribe →</span>
      </a>
      <a href={site.links.whatsapp} class="group rounded-2xl border border-line/60 bg-ink-soft p-6 transition hover:border-accent">
        <h3 class="text-lg font-semibold text-fg">Join the WhatsApp group</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">Announcements and chats with the community.</p>
        <span class="mt-4 inline-block font-semibold text-accent">Open WhatsApp →</span>
      </a>
    </div>

    <div class="mt-16 space-y-12">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Regular meetups</h2>
        <p class="mt-4 leading-relaxed text-fg-muted"><RegularMeetups /></p>
      </div>

      <div>
        <h2 class="text-2xl font-bold tracking-tight">What else we do</h2>
        <p class="mt-4 leading-relaxed text-fg-muted">
          As part of the German and global effective altruism community, we travel to conferences together and help
          members join fellowships — both for engaged EAs making career decisions and for newcomers learning what EA is
          all about.
        </p>
        <p class="mt-4 text-sm text-fg-muted">
          Curious what we've done so far? Have a look at our <a href={href('/news')} class="text-accent hover:underline">news</a>
          and <a href={site.links.newsletterArchive} class="text-accent hover:underline">past newsletter editions</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
